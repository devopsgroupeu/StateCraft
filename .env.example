# StateCraft — environment variables
# StateCraft creates/deletes Terraform state backends (S3 bucket + DynamoDB
# lock table) via boto3. The AWS variables below are for the CLI only: the API
# server ignores them and requires the customer's keys in every request.
# Copy to `.env` and fill in.
# Do NOT commit your real `.env`.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-1
# AWS_SESSION_TOKEN=   # only for temporary (STS) credentials

# Shared token the backend sends as X-Service-Token. Without it the API server does not start.
SERVICE_TOKEN=
# Local development only: run the API server without a token (ignored once SERVICE_TOKEN is set).
# STATECRAFT_AUTH_DISABLED=true
